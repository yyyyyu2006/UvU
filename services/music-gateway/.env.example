# Node >= 22; copy to services/music-gateway/.env
MUSIC_HOST=127.0.0.1
MUSIC_PORT=8787
# Exact browser origins, no path or trailing slash. Replace with your Pages origin.
MUSIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yyyyyu2006.github.io
# Optional: enable server-side encrypted remembered sessions (absolute path advised).
# MUSIC_VAULT_PATH=/var/lib/uvu-music/vault.json
# MUSIC_VAULT_KEY=BASE64_OF_32_RANDOM_BYTES
# Optional direct TLS; otherwise use an HTTPS reverse proxy.
# MUSIC_TLS_CERT=/etc/letsencrypt/live/music.example.com/fullchain.pem
# MUSIC_TLS_KEY=/etc/letsencrypt/live/music.example.com/privkey.pem
